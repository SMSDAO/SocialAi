{
  "name": "socialai",
  "version": "0.1.0",
  "description": "The Open Social Index & Identity Claim Network",
  "private": true,
  "workspaces": [
    "apps/*",
    "node",
    "workers"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/public",
    "dev:node": "node node/socialai.node.js",
    "dev:public": "npm run dev --workspace=apps/public",
    "dev:admin": "npm run start --workspace=apps/admin",
    "dev:desktop": "cd desktop-admin && npm run dev",
    "build": "npm run build --workspace=apps/public",
    "build:public": "npm run build --workspace=apps/public",
    "build:admin": "npm run build --workspace=apps/admin",
    "build:desktop": "cd desktop-admin && npm run build",
    "build:desktop:windows": "node scripts/build-desktop-admin.js",
    "lint": "./apps/public/node_modules/.bin/tsc --noEmit -p apps/public/tsconfig.json",
    "db:init": "psql -U postgres -f db/schema.sql",
    "setup": "node scripts/setup.js"
  },
  "keywords": [
    "social",
    "farcaster",
    "identity",
    "ai"
  ],
  "author": "SocialAi Team",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
